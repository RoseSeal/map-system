GRAPHRAG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Required: the service fails fast at startup when this is empty
GRAPHRAG_LLM_API_KEY=
GRAPHRAG_LLM_MODEL=glm-4-flash
GRAPHRAG_EMBED_MODEL=embedding-3
GRAPHRAG_EMBED_DIM=2048
GRAPHRAG_DEFAULT_TOP_K=5
GRAPHRAG_DEFAULT_MODE=local
GRAPHRAG_RERANKER_ENABLED=false
GRAPHRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Use hf_sequence_classifier for small HuggingFace cross-encoder models such as cross-encoder/ms-marco-MiniLM-L-6-v2.
GRAPHRAG_RERANKER_BACKEND=flagembedding
GRAPHRAG_RERANKER_MIN_SCORE=0.0
