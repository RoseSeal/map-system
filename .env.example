# Optional: override this locally if you need to reuse an existing Docker volume
POSTGIS_VOLUME_NAME=postgis_data

# GraphRAG historical case sidecar
GRAPHRAG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Required: the sidecar fails fast at startup when this is empty
GRAPHRAG_LLM_API_KEY=
GRAPHRAG_LLM_MODEL=glm-4-flash
GRAPHRAG_EMBED_MODEL=embedding-3
GRAPHRAG_EMBED_DIM=2048
GRAPHRAG_DEFAULT_TOP_K=5
GRAPHRAG_DEFAULT_MODE=local
